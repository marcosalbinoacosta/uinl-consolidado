# Copiar a .env.local y completar con los valores reales.
# Los 2 primeros son los mismos que usa el proyecto APP pocket (anon, solo lectura).
# El tercero es la API key de Anthropic, solo necesaria para correr `npm run extract`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
